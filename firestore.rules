rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isSoleAuthorized() {
      return isSignedIn() &&
        request.auth.token.email_verified == true &&
        request.auth.token.email != null &&
        exists(/databases/$(database)/documents/security/soleAccess) &&
        request.auth.token.email.lower() == get(/databases/$(database)/documents/security/soleAccess).data.email;
    }

    // Default deny rule
    match /{document=**} {
      allow read, write: if false;
    }

    // Security collection - Protected soleAccess document
    // Read allowed for sole authorized user; writes forbidden to client apps
    match /security/soleAccess {
      allow read: if isSoleAuthorized();
      allow write: if false;
    }

    // Users Collection - Read allowed only for sole authorized user; client writes forbidden
    match /users/{userEmail} {
      allow read: if isSoleAuthorized();
      allow write: if false;
    }

    // Leads Collection - Read and write restricted to the sole authorized user
    match /leads/{leadId} {
      allow read, write: if isSoleAuthorized();
    }

    // Pending Appointments Collection - Read and write restricted to the sole authorized user
    match /pendingAppointments/{appointmentId} {
      allow read, write: if isSoleAuthorized();
    }
  }
}

